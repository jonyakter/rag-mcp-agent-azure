{
  "ConnectionStrings": {
    "Default": "",
    "OpenAiApiKey": "",
    "OpenAiModel": "text-embedding-3-small"
  },

 

  "Import": {
    "DataFolderPath": "data",
    "InputDir": "data/Book_Dataset",
    "ClearDatabaseOnStartup": true,
    "MaxChunkLength": 4000
  },

  "Recommendation": {
    "MinScoreThreshold": 0.30,
    "DefaultTopN": 5,
    "MaxTopN": 20,
    "MinTopN": 1,
    "ScoreDisplayCeiling": 0.60
  },

  "Memory": {
    "MaxRecallTurns": 10
  },

  "TessData": {
    "TessDataDir": "tessdata",
    "Language": "eng"
  },

  "Export": {
    "OutputFolderPath": "RecommendationResults"
  },

  "DatasetProfiles": [
    {
      "Category": "books",
      "DisplayLabel": "Book Recommendation",
      "FileNameKeywords": [ "book" ],
      "QueryKeywords": [ "read", "book" ],
      "TitleColumns": [ "Book Name", "BookName", "Title" ],
      "Delimiter": ",",
      "SemanticColumns": [ "Book Name", "BookName", "Title", "Author", "Genre", "Description", "Summary" ]
    },
    {
      "Category": "restaurant",
      "DisplayLabel": "Restaurant Recommendation",
      "FileNameKeywords": [ "restaurant", "resturant" ],
      "QueryKeywords": [ "eat", "restaurant", "resturant", "food", "frankfurt", "dining", "cuisine" ],
      "TitleColumns": [ "Restaurant Name", "RestaurantName", "Name" ],
      "Delimiter": ";",
      "SemanticColumns": [ "Restaurant Name", "RestaurantName", "Name", "Cuisines", "City", "Rating" ]
    },
    {
      "Category": "movies",
      "DisplayLabel": "Movie Recommendation",
      "FileNameKeywords": [ "imdb", "movie", "film" ],
      "QueryKeywords": [ "movie", "film", "watch", "cinema", "series" ],
      "TitleColumns": [ "Series_Title", "Title", "Movie Name" ],
      "Delimiter": ",",
      "SemanticColumns": [ "Series_Title", "Genre", "Overview" ]
    }
  ],

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "None",
      "Microsoft.Hosting.Lifetime": "None",
      "Microsoft.EntityFrameworkCore": "None",
      "System.Net.Http": "None"
    }
  }
}